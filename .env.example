# ==========================================
# STORYCONTAINER ENGINE // ENVIRONMENT TEMPLATE
# Sao chép tệp này thành .env và điền thông tin của bạn
# ==========================================

# MySQL Database Configuration
DB_HOST=your_mysql_host_ip
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=your_mysql_database_name

# Connection resilience (ETIMEDOUT / ECONNREFUSED on remote hosts)
DB_CONNECT_TIMEOUT_MS=15000
DB_CONNECT_RETRIES=3
DB_RETRY_DELAY_MS=1500
DB_POOL_SIZE=10

# Managed MySQL providers that require TLS: set true, and optionally a CA bundle.
DB_SSL=false
# DB_SSL_CA=

# Serverless (Vercel): schema provisioning is skipped by default because the schema
# should already exist. Set DB_AUTO_MIGRATE=true only for a fresh database.
# DB_AUTO_MIGRATE=false

# Authentication (REQUIRED in production — set a long random value on Vercel)
JWT_SECRET=your_jwt_signing_secret
JWT_EXPIRES_IN=7d

# Server Port
PORT=3001

# Master Secret for Key Vault AES-256 Encryption & SHA-256 Hashing
CRYPTO_SECRET=your_super_secret_crypto_key

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model LoreBook {
  id                Int         @id @default(autoincrement())
  userId            Int?        @map("user_id")
  title             String      @db.VarChar(255)
  description       String?     @db.Text
  systemInstruction String?     @map("system_instruction") @db.LongText
  language          String?     @default("vi") @db.VarChar(20)
  createdAt         DateTime    @default(now()) @map("created_at")
  loreEntries       LoreEntry[]
  graphState        GraphState?

  @@map("lore_books")
}

model LoreEntry {
  id            Int         @id @default(autoincrement())
  worldId       String?     @map("world_id") @db.VarChar(255)
  bookId        Int?        @map("book_id")
  title         String      @db.VarChar(255)
  category      String      @default("General") @db.VarChar(50) // Character, MagicSystem, Location, Event, General
  aliases       Json?       // Array of string aliases or string
  content       String?     @map("content") @db.LongText // Canonical lore details
  canonicalLore String?     @map("canonical_lore") @db.LongText
  rules         String?     @db.Text
  metadata      Json?       // Polymorphic fields based on category
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at")
  loreBook      LoreBook?   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([worldId, category], name: "idx_lore_world_category")
  @@index([bookId, category], name: "idx_lore_book_category")
  @@index([title], name: "idx_lore_title")
  @@map("lore_entries")
}

model GraphState {
  id        String    @id @default(uuid())
  worldId   String    @unique @map("world_id") @db.VarChar(255)
  nodes     Json      // React Flow node positions and UI state
  edges     Json      // React Flow connection edges
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([worldId], name: "idx_graph_world")
  @@map("graph_states")
}

model NodeConnection {
  id           String   @id @default(uuid())
  worldId      String   @map("world_id") @db.VarChar(255)
  sourceNodeId String   @map("source_node_id") @db.VarChar(255)
  targetNodeId String   @map("target_node_id") @db.VarChar(255)
  edgeType     String   @default("relationship") @map("edge_type") @db.VarChar(50)
  label        String?  @db.VarChar(255)
  data         Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([worldId], name: "idx_node_conn_world")
  @@map("node_connections")
}

model ApiKeysVault {
  id               Int      @id @default(autoincrement())
  provider         String   @default("gemini") @db.VarChar(32) // gemini, deepseek, openrouter, huggingface
  baseUrl          String?  @map("base_url") @db.VarChar(255)
  keyHash          String   @map("key_hash") @db.VarChar(64)
  encryptedKey     String   @map("encrypted_key") @db.Text
  maskedKey        String   @map("masked_key") @db.VarChar(32)
  status           String   @default("active") @db.VarChar(32)
  callCount        Int      @default(0) @map("call_count")
  requestCount     Int      @default(0) @map("request_count")
  rateLimitCount   Int      @default(0) @map("rate_limit_count")
  lastUsedAt       BigInt?  @map("last_used_at")
  rateLimitedUntil BigInt?  @map("rate_limited_until")
  errorMsg         String?  @map("error_msg") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([provider, keyHash], name: "unique_provider_key")
  @@map("api_keys_vault")
}

model UserApiKey {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  provider         String   @default("gemini") @db.VarChar(32) // gemini, deepseek, openrouter, huggingface
  baseUrl          String?  @map("base_url") @db.VarChar(255)
  keyHash          String   @map("key_hash") @db.VarChar(64)
  encryptedKey     String   @map("encrypted_key") @db.Text
  maskedKey        String   @map("masked_key") @db.VarChar(32)
  status           String   @default("active") @db.VarChar(32)
  callCount        Int      @default(0) @map("call_count")
  requestCount     Int      @default(0) @map("request_count")
  rateLimitCount   Int      @default(0) @map("rate_limit_count")
  lastUsedAt       BigInt?  @map("last_used_at")
  rateLimitedUntil BigInt?  @map("rate_limited_until")
  errorMsg         String?  @map("error_msg") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([userId, provider, keyHash], name: "unique_user_provider_key")
  @@map("user_api_keys")
}

model ChatSession {
  id               String        @id @db.VarChar(64)
  userId           Int?          @map("user_id")
  bookId           Int?          @map("book_id")
  title            String        @db.VarChar(255)
  rollingThreshold Int?          @default(32768) @map("rolling_threshold")
  createdAt        DateTime      @default(now()) @map("created_at")
  messages         ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id               Int          @id @default(autoincrement())
  sessionId        String       @map("session_id") @db.VarChar(64)
  role             String       @db.VarChar(20) // user, model, system
  content          String       @db.LongText
  retrievedLoreIds String?      @default("") @map("retrieved_lore_ids") @db.VarChar(255)
  createdAt        DateTime     @default(now()) @map("created_at")
  session          ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], name: "idx_session_id")
  @@map("chat_messages")
}

